@startuml

entity User {
	* primary_key <<generated>>
	* id <<snowflake>>
	--
	identity_id
	--
	* username
	password <<hash>>
	* role
	* enabled <<boolean>>
	* created_at <<timestamptz>>
	* updated_at <<timestamptz>>
}

entity PushSubscription {
	* primary_key <<generated>>
	* id <<snowflake, unique>>
	* endpoint <<unique>>
	* p256dh
	* auth
	* owner_id <<foreign key>>
}

entity Trip {
	* primary_key <<generated>>
	* id <<snowflake>>
	--
	* owner_id
	--
	* name
	description
	* started_at <<date>>
	ended_at <<date>>
	cover <<url>>
	* created_at <<timestamptz>>
	* updated_at <<timestamptz>>
}

entity Waypoint {
	* primary_key <<generated>>
	* id <<snowflake>>
	--
	* trip_id
	--
	* latitude
	* longitude
	* name
	description
}

entity Movement {
	* primary_key <<generated>>
	* id <<snowflake>>
	--
	* starts_at_waypoint_id
	* ends_at_waypoint_id
	--
	* transport_type
	description
	* started_at <<timestamptz>>
	* ends_at <<timestamptz>>
}

entity Event {
	* primary_key <<generated>>
	* id <<snowflake>>
	--
	* trip_id
	waypoint_id
	--
	* title
	* type
	description
	* started_at
	ended_at
	booking_url
}

User ||--o{ PushSubscription
User ||--o{ Trip : owner
Trip ||--o{ Waypoint
Waypoint ||--o{ Movement : starts_at_waypoint, ends_at_waypoint
Trip ||--o{ Event
entity GoogleDriveConnection {
    * primary_key <<generated>>
    * user_id <<unique, FK User>>
    * generation
    * status
    permission_id
    email
    refresh_token_encrypted <<Fernet>>
    scopes
    folder_id
    * revocation_pending
    oauth_state_hash <<unique>>
    oauth_cookie_hash
    oauth_expires_at <<timestamptz>>
    * oauth_state_used
}

entity GoogleDriveExport {
    * primary_key <<generated>>
    * id <<snowflake>>
    * user_id <<FK User>>
    * connection_id <<FK GoogleDriveConnection>>
    * connection_generation
    * idempotency_key <<unique with user_id>>
    * name
    * mime_type
    * size
    * sha256
    * md5
    * status
    * drive_file_id
    web_view_link
    error_reason
    * created_at <<timestamptz>>
}

User ||--o| GoogleDriveConnection
User ||--o{ GoogleDriveExport
GoogleDriveConnection ||--o{ GoogleDriveExport

@enduml
