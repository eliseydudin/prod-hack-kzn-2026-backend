{
  "uid": "backend-api",
  "title": "Backend API",
  "description": "Requests to /api as seen by Nginx, plus internal probes of the backend and telemetry services.",
  "schemaVersion": 41,
  "tags": ["backend", "api"],
  "time": {"from": "now-1h", "to": "now"},
  "refresh": "30s",
  "links": [
    {"title": "Backend Logs", "type": "link", "url": "/d/backend-logs", "includeVars": false, "keepTime": true}
  ],
  "panels": [
    {
      "id": 1,
      "title": "API health",
      "description": "HTTP probe of the existing /health endpoint inside the Docker network.",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "backend-prometheus"},
      "targets": [{"refId": "A", "expr": "probe_success{job=\"backend-probes\",service=\"api\"}", "instant": true, "range": false}],
      "options": {"colorMode": "background", "graphMode": "none"},
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "Down", "color": "red"}, "1": {"text": "Up", "color": "green"}}}]}}
    },
    {
      "id": 2,
      "title": "API requests / s",
      "type": "stat",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "backend-prometheus"},
      "targets": [{"refId": "A", "expr": "sum(rate(api_http_requests_total[$__rate_interval]))", "instant": true, "range": false}],
      "options": {"colorMode": "none", "graphMode": "none"},
      "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 2}}
    },
    {
      "id": 3,
      "title": "5xx error rate",
      "description": "Share of API responses with 5xx status, including Nginx gateway failures. Blank when there is no traffic.",
      "type": "stat",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "backend-prometheus"},
      "targets": [{"refId": "A", "expr": "(sum(rate(api_http_requests_total{status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(api_http_requests_total[$__rate_interval]))", "instant": true, "range": false}],
      "options": {"colorMode": "value", "graphMode": "none"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.01}, {"color": "red", "value": 0.05}]}}}
    },
    {
      "id": 4,
      "title": "p95 request duration",
      "type": "stat",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "backend-prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(api_http_request_duration_seconds_bucket[$__rate_interval])))", "instant": true, "range": false}],
      "options": {"colorMode": "none", "graphMode": "none"},
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 5,
      "title": "Traffic by HTTP status",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "backend-prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (status) (rate(api_http_requests_total[$__rate_interval]))", "legendFormat": "{{status}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}}
    },
    {
      "id": 6,
      "title": "Request duration",
      "description": "Time measured by Nginx for completed requests, including upstream and proxy time.",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "backend-prometheus"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(api_http_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p50"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(api_http_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95"},
        {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(api_http_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p99"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}}
    },
    {
      "id": 7,
      "title": "Service connectivity",
      "description": "HTTP for API, TCP for PostgreSQL and Valkey, and Prometheus scrape status for Vector and Loki.",
      "type": "state-timeline",
      "gridPos": {"x": 0, "y": 12, "w": 24, "h": 7},
      "datasource": {"type": "prometheus", "uid": "backend-prometheus"},
      "targets": [{"refId": "A", "expr": "probe_success{job=\"backend-probes\"} or up{job=\"telemetry\"}", "legendFormat": "{{service}}"}],
      "options": {"mergeValues": true, "legend": {"showLegend": false}},
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "Down", "color": "red"}, "1": {"text": "Up", "color": "green"}}}]}}
    }
  ]
}
